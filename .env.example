# 필수 — 아래 각각은 「평문 API 키」의 SHA-256 hex 예시입니다.
API_KEY_HASH=<sha256-of-your-api-key>
ADMIN_API_KEY_HASH=<sha256-of-your-admin-api-key>

# 호출 시 `X-API-Key` 헤더에는 이 해시 문자열을 넣지 말고, 해시를 만든 원래 「평문 키」를 넣습니다.
# 평문+해시 생성: python3 -c "import secrets,hashlib; k=secrets.token_hex(16); print('PLAIN=', k); print('ADMIN_API_KEY_HASH=', hashlib.sha256(k.encode()).hexdigest())"

# 필수 — 네이버 블로그 검색
NAVER_CLIENT_ID=<네이버 개발자센터 Client ID>
NAVER_CLIENT_SECRET=<네이버 개발자센터 Client Secret>

# Redis (미설정 시 기본 localhost)
REDIS_URL=redis://localhost:6379/0

# 선택 — 애플리케이션 로그 레벨 (Swagger/수동 트리거 시 runner INFO 확인용, 미설정 시 INFO)
LOG_LEVEL=INFO

# 선택 — 네이버 HTTP 타임아웃(ms)
NAVER_TIMEOUT_MS=10000

# SQLite 원본 포스트 저장 경로 (기본값: data/raw_posts.db)
# SQLITE_PATH=data/raw_posts.db
